# --- OpenAI ---
# Used for the Realtime (speech-to-speech) session and for post-call bug analysis.
OPENAI_API_KEY=sk-...

# --- Twilio ---
# From the Twilio Console. Used to place outbound calls and download recordings.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
# A Twilio voice-capable number you own, in E.164 format. This is the single number
# you will use for ALL test calls (the assessment requires one consistent caller ID).
TWILIO_FROM_NUMBER=+15551234567

# --- Networking ---
# Public base URL that Twilio can reach (e.g. your ngrok https URL, no trailing slash).
# Example: https://abc123.ngrok-free.app
PUBLIC_URL=https://your-ngrok-subdomain.ngrok-free.app

# Local port the relay server binds to.
PORT=8000

# --- Realtime model ---
# Override if OpenAI changes the model name. The g711 passthrough config assumes a
# realtime-capable model.
REALTIME_MODEL=gpt-4o-realtime-preview-2024-12-17

# Voice for the patient persona (alloy, echo, shimmer, etc.)
REALTIME_VOICE=alloy
